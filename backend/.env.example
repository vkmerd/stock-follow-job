# ─── Vega Panel API ───────────────────────────────────────────
PORT=3001
DATABASE_URL="postgresql://KULLANICI:SIFRE@HOST/VERITABANI?sslmode=require"
VITE_API_URL=https://panel.vegacantastore.com/api
FRONTEND_URL=https://panel.vegacantastore.com

# ─── Shopify (ürün çekmek için) ───────────────────────────────
# Mağaza: Shopify Admin → Ayarlar → Mağaza ayrıntıları → myshopify.com adresi
# Örnek: vega-canta-store.myshopify.com  (vegacantastore.com DEĞİL)
SHOPIFY_STORE_URL=https://vega-canta-store.myshopify.com

# Token: Admin → Ayarlar → Uygulamalar → Uygulama geliştir → Custom app
#         → read_products scope → Install → "Admin API access token"
# shpat_ ile başlar. shpss_ (Client Secret) BURAYA YAZMAYIN.
SHOPIFY_ACCESS_TOKEN=shpat_BURAYA_GERCEK_TOKEN

# İsteğe bağlı (eski isimler de desteklenir):
# SHOPIFY_SHOP=vega-canta-store.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_...
SHOPIFY_API_VERSION=2025-01
